<!-- Google Analytics 4 (GA4) + Cookie Consent -->
<div id="cookie-consent" class="cookie-notice" style="display: none;">
  <p class="cookie-notice-text">We use cookies to measure website performance. Do you consent to Google Analytics tracking?</p>
  <div class="cookie-notice-actions">
    <button id="cookie-accept" class="btn btn-sm btn-primary">Accept</button>
    <button id="cookie-decline" class="btn btn-sm btn-ghost">Decline</button>
  </div>
</div>

<!-- LocalBusiness Schema -->
<script type="application/ld+json">
