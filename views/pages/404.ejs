<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 Page Not Found | Ajay Singla</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <main style="display: flex; align-items: center; justify-content: center; min-height: 60vh; text-align: center;">
    <div class="container">
      <div class="card card-dark" style="max-width: 540px; margin: 0 auto; padding: var(--space-6);">
        <span class="eyebrow">Error 404</span>
        <h1 style="font-size: var(--text-xl); margin-top: var(--space-2); margin-bottom: var(--space-3);">Page Not Found</h1>
        <p>The page you requested (<code style="color: var(--text-hi);"><%= typeof url !== 'undefined' ? url : '' %></code>) could not be located or may have been moved.</p>
        <div style="margin-top: var(--space-5);">
          <a href="/" class="btn btn-primary">Return to Home</a>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
