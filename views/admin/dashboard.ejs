<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard | Ajay Singla</title>
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <style>
    body { background: var(--bg-2); }
    .admin-nav { background: var(--surface); padding: 16px 24px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; }
    .table { width: 100%; border-collapse: collapse; margin-top: 16px; background: var(--surface); border-radius: 8px; overflow: hidden; }
    .table th, .table td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--line); }
    .table th { background: var(--bg-2); font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-soft); }
    .table tr:hover { background: rgba(0,0,0,0.02); }

  </style>
</head>
<body>
  <nav class="admin-nav">
    <div style="font-weight: 700;">Ajay Singla Admin</div>
    <div>
      <a href="/admin/submissions/export.csv" class="btn btn-ghost" style="padding: 6px 12px; font-size: 0.85rem;">Export CSV</a>
      <a href="/admin/logout" class="btn btn-primary" style="padding: 6px 12px; font-size: 0.85rem; margin-left: 8px;">Logout</a>
    </div>
  </nav>

  <main class="container" style="padding: 40px 24px;">
    <h2>Submissions</h2>
    <div class="mt-4 card card-light" style="padding: 16px;">
      <form action="/admin/dashboard" method="GET" style="display: flex; gap: 16px; align-items: flex-end;">
        <div>
          <label class="form-label">Search</label>
          <input type="text" name="search" value="<%= search %>" class="form-control" placeholder="Name, email, phone">
        </div>
        <div>
          <label class="form-label">Status</label>
          <select name="status" class="select">
            <option value="">All</option>
            <option value="new" <%= status === 'new' ? 'selected' : '' %>>New</option>
            <option value="read" <%= status === 'read' ? 'selected' : '' %>>Read</option>
            <option value="replied" <%= status === 'replied' ? 'selected' : '' %>>Replied</option>
            <option value="archived" <%= status === 'archived' ? 'selected' : '' %>>Archived</option>
          </select>
        </div>
        <button type="submit" class="btn btn-primary" style="padding: 8px 16px;">Filter</button>
      </form>
    </div>

    <table class="table mt-4">
      <thead>
        <tr>
          <th>Date</th>
          <th>Name</th>
          <th>Service</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% if (submissions && submissions.length > 0) { %>
          <% submissions.forEach(sub => { %>
            <tr>
              <td><%= new Date(sub.created_at).toLocaleDateString() %></td>
              <td>
                <div style="font-weight: 500;"><%= sub.name %></div>
                <div style="font-size: 0.85rem; color: var(--ink-soft);"><%= sub.email %></div>
              </td>
              <td><%= sub.service_title || 'General Enquiry' %></td>
              <td><span class="badge <%= sub.status === 'new' ? 'badge-new' : sub.status === 'read' ? 'badge-light' : sub.status === 'replied' ? 'badge-success' : 'badge-muted' %>"><%= sub.status %></span></td>
              <td><a href="/admin/submissions/<%= sub.id %>" class="btn-link">View &rarr;</a></td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5" class="text-center py-4">No submissions found.</td></tr>
        <% } %>
      </tbody>
    </table>

    <div class="mt-4 text-center">
      <span class="text-sm color-ink-soft">Showing <%= submissions.length %> of <%= total %> records</span>
    </div>
  </main>
</body>
</html>
